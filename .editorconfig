# EditorConfig — https://editorconfig.org
# Standardizes formatting across editors for this repository.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Pine Script source
[*.pine]
indent_style = space
indent_size = 4

# Markdown documentation (trailing whitespace can be significant for line breaks)
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# YAML / JSON tooling files
[*.{yml,yaml,json}]
indent_size = 2
