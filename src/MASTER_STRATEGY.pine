// =============================================================================
//  CORE FRAMEWORK SUBSYSTEMS
// -----------------------------------------------------------------------------
//  The Core Framework, in dependency order (leaf -> composite):
//    util -> log -> err -> cfg -> ctx -> state -> lifecycle
//  Section ordering is canonical (STYLE_GUIDE §8). Foundation only — no trading
//  logic anywhere in this file.
// =============================================================================

// -----------------------------------------------------------------------------
//  Core · util — pure, deterministic helpers (M1.2).
//  Side-effect free. No indicators, no trading logic.
// -----------------------------------------------------------------------------

// utilIsValidNumber(value)   @stable
//   Responsibility : Report whether a value is usable (not na).
//   Parameters     : value — float.
//   Returns        : bool — true when value is not na.
//   Determinism    : pure; no state.
//   Errors         : none. Note: Pine surfaces non-finite results as na.
utilIsValidNumber(float value) =>
    not na(value)

// utilClamp(value, lo, hi)   @stable
//   Responsibility : Constrain value to the inclusive range [lo, hi].
//   Returns        : float — the clamped value.
//   Determinism    : pure.  Errors: none.
utilClamp(float value, float lo, float hi) =>
    math.max(lo, math.min(hi, value))

// utilSafeDiv(num, den, fallback)   @stable
//   Responsibility : Divide, guarding against zero / na operands.
//   Returns        : float — num / den, or fallback when unsafe.
//   Determinism    : pure.  Errors: none (returns fallback instead of na/inf).
utilSafeDiv(float num, float den, float fallback) =>
    na(den) or na(num) or den == 0 ? fallback : num / den

// utilNormalize(value, lo, hi)   @stable
//   Responsibility : Scale value from [lo, hi] into [0, 1], clamped.
//   Returns        : float in [0, 1]; the lower bound when lo == hi (safe).
//   Determinism    : pure.  Errors: none.
utilNormalize(float value, float lo, float hi) =>
    float ratio = utilSafeDiv(value - lo, hi - lo, UTIL_NORMALIZED_MIN)
    utilClamp(ratio, UTIL_NORMALIZED_MIN, UTIL_NORMALIZED_MAX)

// utilRoundToTick(price)   @stable
//   Responsibility : Round a price to the instrument tick (syminfo.mintick).
//   Returns        : float — tick-aligned price; input passed through when invalid.
//   Determinism    : pure w.r.t. price and symbol.  Errors: none.
utilRoundToTick(float price) =>
    utilIsValidNumber(price) ? math.round(price / syminfo.mintick) * syminfo.mintick : price

// utilMinutesOfDay(t)   @internal
//   Responsibility : Minutes elapsed since midnight (exchange tz) for time t.
//   Returns        : int — hour * 60 + minute.
//   Determinism    : pure given t.  Errors: none.
utilMinutesOfDay(int t) =>
    hour(t) * MINUTES_PER_HOUR + minute(t)

// utilFormatFloat(value, precision)   @internal
//   Responsibility : Format a float to a fixed number of decimals for diagnostics.
//   Returns        : string — "na" when value is na.
//   Determinism    : pure.  Errors: none.
utilFormatFloat(float value, int precision) =>
    if na(value)
        "na"
    else
        float factor = math.pow(DECIMAL_BASE, precision)
        str.tostring(math.round(value * factor) / factor)

// -----------------------------------------------------------------------------
//  Core · log — bounded diagnostics ring buffer.
//  O(1) insertion. Gated by level + debug. Operates on a caller-owned
//  Diagnostics handle (KernelState.diag in the wired lifecycle).
// -----------------------------------------------------------------------------

// logLevelRank(level)   @internal
//   Responsibility : Ordinal severity rank (0 = highest). Single source of the
//                    ordering so logShouldEmit does not duplicate the mapping
//                    (satisfies the no-duplication rule).
//   Returns        : int rank in [0, 3].
//   Determinism    : pure.  Errors: none.
logLevelRank(LogLevel level) =>
    switch level
        LogLevel.error => 0
        LogLevel.warn  => 1
        LogLevel.info  => 2
        LogLevel.debug => 3
        => 3

// logInitBuffer(diag, capacity)   @internal
//   Responsibility : Allocate the fixed-capacity ring buffer and reset counters.
//                    Single source of buffer initialization (no-duplication rule).
//   Parameters     : diag — Diagnostics to initialize; capacity — buffer size.
//   Returns        : void.  Determinism: deterministic.  Errors: none.
logInitBuffer(Diagnostics diag, int capacity) =>
    diag.entries      := array.new<LogEntry>(capacity)
    diag.capacity     := capacity
    diag.head         := 0
    diag.count        := 0
    diag.droppedCount := 0

// logShouldEmit(level, threshold, debugEnabled)   @internal
//   Responsibility : Decide whether a message at `level` is emitted, given the
//                    active threshold and debug flag.
//   Returns        : bool.
//   Determinism    : pure.  Errors: none.
logShouldEmit(LogLevel level, LogLevel threshold, bool debugEnabled) =>
    bool passesThreshold = logLevelRank(level) <= logLevelRank(threshold)
    bool requiresDebug   = level == LogLevel.debug or level == LogLevel.info
    passesThreshold and (not requiresDebug or debugEnabled)

// logFormat(entry)   @internal
//   Responsibility : Render a LogEntry as one diagnostic line.
//   Returns        : string "[LEVEL MODULE ERRID b#N] message".
//   Determinism    : pure.  Errors: none.
logFormat(LogEntry entry) =>
    string levelLabel = switch entry.level
        LogLevel.error => "ERROR"
        LogLevel.warn  => "WARN"
        LogLevel.info  => "INFO"
        LogLevel.debug => "DEBUG"
        => "INFO"
    string idPart = entry.errorId == ERR_NONE ? "" : " " + entry.errorId
    "[" + levelLabel + " " + entry.moduleId + idPart + " b#" + str.tostring(entry.barIndex) + "] " + entry.message

// logWrite(diag, level, moduleId, errorId, message, threshold, debugEnabled)   @stable
//   Responsibility : Append one gated entry to the ring buffer (O(1)).
//   Returns        : void.
//   Determinism    : deterministic per bar (stamps bar_index / time).
//   Errors         : none. Note: the oldest entry is overwritten when full.
logWrite(Diagnostics diag, LogLevel level, string moduleId, string errorId, string message, LogLevel threshold, bool debugEnabled) =>
    if logShouldEmit(level, threshold, debugEnabled)
        if na(diag.entries)
            logInitBuffer(diag, DIAG_BUFFER_CAP)
        LogEntry entry = LogEntry.new(level, bar_index, time, moduleId, errorId, message)
        array.set(diag.entries, diag.head, entry)
        diag.head := (diag.head + 1) % diag.capacity
        if diag.count < diag.capacity
            diag.count := diag.count + 1
        else
            diag.droppedCount := diag.droppedCount + 1

// logDrain(diag)   @experimental
//   Responsibility : Snapshot buffered entries, oldest -> newest.
//   Returns        : array<LogEntry> — a new array; empty when nothing buffered.
//   Determinism    : deterministic. Complexity O(count), count <= DIAG_BUFFER_CAP;
//                    on-demand, not a per-bar hot path.
//   Errors         : none.
logDrain(Diagnostics diag) =>
    array<LogEntry> out = array.new<LogEntry>(0)
    if not na(diag.entries) and diag.count > 0
        int start = (diag.head - diag.count + diag.capacity) % diag.capacity
        for i = 0 to diag.count - 1
            array.push(out, array.get(diag.entries, (start + i) % diag.capacity))
    out

// logClear(diag)   @experimental
//   Responsibility : Logically empty the buffer (O(1); counters reset).
//   Returns        : void.  Determinism: deterministic.  Errors: none.
logClear(Diagnostics diag) =>
    diag.head         := 0
    diag.count        := 0
    diag.droppedCount := 0

// -----------------------------------------------------------------------------
//  Core · err — error handling and hybrid validation (M1.2).
//  Fatal -> halt (runtime.error); recoverable -> logged warning.
// -----------------------------------------------------------------------------

// errFormat(severity, errorId, message)   @internal
//   Responsibility : Render an error / validation line.
//   Returns        : string "[SEVERITY] ERRID: message".
//   Determinism    : pure.  Errors: none.
errFormat(ValidationSeverity severity, string errorId, string message) =>
    string sev = switch severity
        ValidationSeverity.fatal   => "FATAL"
        ValidationSeverity.warning => "WARNING"
        ValidationSeverity.ok      => "OK"
        => "OK"
    string idPart = errorId == ERR_NONE ? "" : errorId + ": "
    "[" + sev + "] " + idPart + message

// errRaiseFatal(errorId, message)   @stable
//   Responsibility : Abort the script with a descriptive fatal error.
//   Returns        : never (runtime.error halts execution).
//   Determinism    : deterministic.  Errors: raises runtime.error by design.
errRaiseFatal(string errorId, string message) =>
    runtime.error(errFormat(ValidationSeverity.fatal, errorId, message))

// errWarn(diag, errorId, message, threshold, debugEnabled)   @stable
//   Responsibility : Record a non-fatal warning to diagnostics.
//   Returns        : void.  Determinism: deterministic.  Errors: none.
errWarn(Diagnostics diag, string errorId, string message, LogLevel threshold, bool debugEnabled) =>
    logWrite(diag, LogLevel.warn, MODULE_ID_CORE, errorId, message, threshold, debugEnabled)

// errAssert(condition, errorId, message, debugEnabled)   @stable
//   Responsibility : Debug-only invariant check; halts if it fails while debug is on.
//   Returns        : void.  Determinism: deterministic.
//   Errors         : raises runtime.error when debugEnabled and condition is false.
errAssert(bool condition, string errorId, string message, bool debugEnabled) =>
    if debugEnabled and not condition
        errRaiseFatal(errorId, "assertion failed: " + message)

// errApplyValidation(diag, results, threshold, debugEnabled)   @experimental
//   Responsibility : Apply the hybrid policy over validation results —
//                    the first fatal halts; each warning is logged.
//   Returns        : void.  Determinism: deterministic. Complexity O(size(results)).
//   Errors         : raises runtime.error on the first fatal result.
errApplyValidation(Diagnostics diag, array<ValidationResult> results, LogLevel threshold, bool debugEnabled) =>
    int n = na(results) ? 0 : array.size(results)
    // Guard the range: `for 0 to n-1` with n == 0 must not iterate.
    if n > 0
        for i = 0 to n - 1
            ValidationResult r = array.get(results, i)
            // Independent statements (not an if/else-if expression) so the fatal
            // (runtime.error) and warning branches do not share a return type.
            if r.severity == ValidationSeverity.fatal
                errRaiseFatal(r.errorId, r.message)
            if r.severity == ValidationSeverity.warning
                errWarn(diag, r.errorId, r.message, threshold, debugEnabled)

// -----------------------------------------------------------------------------
//  Core · cfg — configuration build / validate / accessor (M1.3).
//  cfgBuild is the ONLY reader of input.*. Config is treated as immutable after
//  build (enforced by convention; ADR-0008). Modules read it via cfgGet.
// -----------------------------------------------------------------------------

// cfgValidate(draft)   @internal
//   Responsibility : Validate and normalize a draft Config, returning findings.
//                    Recoverable issues are clamped in place; the M1.2 err
//                    subsystem applies the policy (no duplicated validation).
//   Parameters     : draft — Config (mutated: out-of-range scalars are clamped).
//   Returns        : array<ValidationResult>.
//   Determinism    : deterministic.  Errors: none (reports; does not raise).
cfgValidate(Config draft) =>
    array<ValidationResult> results = array.new<ValidationResult>(0)
    // Fatal: an enabled session window must be well-formed (start before end).
    if draft.sessionEnabled and draft.sessionStartMinute >= draft.sessionEndMinute
        array.push(results, ValidationResult.new(ValidationSeverity.fatal, ERR_CFG_INVALID_SESSION, "session start must be before session end"))
    // Recoverable: clamp the diagnostics buffer cap into its valid range.
    int clampedCap = int(utilClamp(draft.diagBufferCap, DIAG_BUFFER_CAP_MIN, DIAG_BUFFER_CAP))
    if clampedCap != draft.diagBufferCap
        array.push(results, ValidationResult.new(ValidationSeverity.warning, ERR_CFG_DIAG_CAP_RANGE, "diagBufferCap out of range; clamped to " + str.tostring(clampedCap)))
        draft.diagBufferCap := clampedCap
    results

// cfgBuild(diag)   @experimental
//   Responsibility : Read inputs once, validate, and return the config snapshot.
//                    The only place input.* is read (ADR-0008).
//   Parameters     : diag — Diagnostics handle for recoverable warnings.
//   Returns        : Config — immutable after this call (by convention).
//   Determinism    : deterministic per run.
//   Errors         : fatal — halts via errApplyValidation on invalid config.
//   Note           : primaryTfClass is finalized in stateInit, which holds both
//                    the built Config and ctxTimeframe().
cfgBuild(Diagnostics diag) =>
    Config draft = Config.new()
    draft.debugEnabled       := inpDebugEnabled
    draft.logThreshold       := inpLogThreshold
    draft.requireSupportedTf := inpRequireSupportedTf
    draft.sessionEnabled     := inpSessionEnabled
    draft.sessionStartMinute := inpSessionStart
    draft.sessionEndMinute   := inpSessionEnd
    draft.diagBufferCap      := inpDiagBufferCap
    draft.enableCore         := inpEnableCore
    draft.enableTrend        := inpEnableTrend
    draft.enableMomentum     := inpEnableMomentum
    draft.enableSr           := inpEnableSr
    draft.enableStructure    := inpEnableStructure
    draft.enableLiquidity    := inpEnableLiquidity
    draft.enableOrderBlock   := inpEnableOrderBlock
    draft.enableFvg          := inpEnableFvg
    draft.enableSignal       := inpEnableSignal
    draft.enableTrade        := inpEnableTrade
    draft.enableRisk         := inpEnableRisk
    draft.enableDashboard    := inpEnableDashboard
    draft.enableAlerts       := inpEnableAlerts
    draft.enableOptimize     := inpEnableOptimize
    array<ValidationResult> results = cfgValidate(draft)
    errApplyValidation(diag, results, draft.logThreshold, draft.debugEnabled)
    draft

// cfgGet(state)   @stable
//   Responsibility : Return the cached, immutable Config from kernel state.
//   Parameters     : state — KernelState holding the built Config.
//   Returns        : Config.
//   Determinism    : pure accessor.  Errors: none.
//   Note           : takes the KernelState handle by design — the single global
//                    lives in MAIN and is passed to functions by reference.
cfgGet(KernelState state) =>
    state.config

// -----------------------------------------------------------------------------
//  Core · ctx — per-bar context: confirmed-bar / session / timeframe (M1.3),
//  plus the sanctioned higher-timeframe read ctxHtfValue (M2.1).
//  Non-repainting throughout. ALL request.security in the strategy lives inside
//  ctxHtfValue (ADR-0011); it appears nowhere else.
// -----------------------------------------------------------------------------

// ctxTimeframe()   @internal
//   Responsibility : Classify the chart timeframe (constant per run).
//   Returns        : TimeframeContext (class + isSupportedPrimary).
//   Determinism    : deterministic; non-repainting.  Errors: none.
ctxTimeframe() =>
    TimeframeClass cls = timeframe.isminutes and timeframe.multiplier == TF_M1_MINUTES ? TimeframeClass.m1 : timeframe.isminutes and timeframe.multiplier == TF_M5_MINUTES ? TimeframeClass.m5 : TimeframeClass.other
    TimeframeContext.new(cls, cls == TimeframeClass.m1 or cls == TimeframeClass.m5)

// ctxComputeSession(cfg)   @internal
//   Responsibility : Determine session state for the current bar.
//   Parameters     : cfg — Config (session settings).
//   Returns        : SessionContext.
//   Determinism    : deterministic per bar; non-repainting (current-bar time).
//   Errors         : none.
ctxComputeSession(Config cfg) =>
    bool active = true
    if cfg.sessionEnabled
        int m = utilMinutesOfDay(time)
        active := m >= cfg.sessionStartMinute and m < cfg.sessionEndMinute
    SessionContext.new(active ? SessionState.active : SessionState.inactive, active)

// ctxIsConfirmedBar()   @stable
//   Responsibility : Whether the current bar is closed / confirmed.
//   Returns        : bool — barstate.isconfirmed.
//   Determinism    : deterministic; non-repainting.  Errors: none.
ctxIsConfirmedBar() =>
    barstate.isconfirmed

// ctxIsNewBar()   @stable
//   Responsibility : Whether this is the first execution of a new bar.
//   Returns        : bool — barstate.isnew.
//   Determinism    : deterministic; non-repainting.  Errors: none.
ctxIsNewBar() =>
    barstate.isnew

// ctxBuild(cfg)   @experimental
//   Responsibility : Assemble the per-bar context.
//   Parameters     : cfg — Config.
//   Returns        : BarContext (transient).
//   Determinism    : deterministic per bar; non-repainting.  Errors: none.
ctxBuild(Config cfg) =>
    BarContext.new(bar_index, time, ctxIsConfirmedBar(), ctxIsNewBar(), ctxComputeSession(cfg), ctxTimeframe())

// ctxIsHigherTimeframe(tf)   @internal
//   Responsibility : Whether `tf` is higher than or equal to the chart timeframe
//                    (i.e. a valid higher-timeframe target).
//   Parameters     : tf — a timeframe string (e.g. "5", "15", "60").
//   Returns        : bool — true when tf >= chart timeframe.
//   Determinism    : deterministic; constant per run.  Errors: none.
//   Note           : parameter is named `tf` (not `timeframe`) to avoid shadowing
//                    the `timeframe.*` builtin namespace.
ctxIsHigherTimeframe(string tf) =>
    timeframe.in_seconds(tf) >= timeframe.in_seconds()

// ctxHtfValue(symbol, tf, expr)   @stable
//   Responsibility : The single sanctioned higher-timeframe read. ALL
//                    request.security in the strategy lives here (ADR-0011);
//                    modules consume this, never request.security directly.
//   Parameters     : symbol — ticker id (e.g. syminfo.tickerid).
//                    tf     — target timeframe string (>= chart timeframe).
//                    expr   — series float to evaluate in the HTF context.
//   Returns        : float — the value from the last CLOSED HTF bar.
//   Determinism    : deterministic; non-repainting.
//   Non-repainting : lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off,
//                    and expr[1] so only confirmed (closed) HTF bars are read — a
//                    1 HTF-bar lag by design (docs/KNOWN_LIMITATIONS.md).
//   Errors         : none (na propagates when HTF history is unavailable; callers
//                    guard with utilIsValidNumber).
//   Note           : parameter is named `tf` (not `timeframe`) to avoid shadowing
//                    the `timeframe.*` builtin namespace.
ctxHtfValue(string symbol, string tf, float expr) =>
    request.security(symbol, tf, expr[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

// -----------------------------------------------------------------------------
//  Core · state — single persistent KernelState (M1.4).
//  The KernelState object is the sole mutable global (ADR-0009); it is created
//  in global scope (MAIN) and threaded to these functions by reference.
// -----------------------------------------------------------------------------

// stateInit(config, diag)   @experimental
//   Responsibility : Build the kernel state on the first bar: cache config, size
//                    the diagnostics buffer from config.diagBufferCap, finalize
//                    primaryTfClass, and enforce requireSupportedTf.
//   Parameters     : config — validated Config; diag — diagnostics buffer to adopt
//                    (reuses the one cfgBuild logged into, preserving warnings).
//   Returns        : KernelState (initialized).
//   Determinism    : deterministic per run.
//   Errors         : fatal — halts if requireSupportedTf and the timeframe is unsupported.
stateInit(Config config, Diagnostics diag) =>
    KernelState state = KernelState.new()
    state.config := config
    if na(diag.entries)
        logInitBuffer(diag, config.diagBufferCap)
    state.diag := diag
    state.tf := ctxTimeframe()
    state.config.primaryTfClass := state.tf.tfClass
    if config.requireSupportedTf and not state.tf.isSupportedPrimary
        errRaiseFatal(ERR_CFG_UNSUPPORTED_TF, "unsupported chart timeframe; require a primary M1 or M5 chart")
    state.initialized := true
    state

// stateUpdate(state, context)   @experimental
//   Responsibility : Advance persistent counters for the current bar (O(1)).
//   Parameters     : state — KernelState; context — the bar's BarContext.
//   Returns        : void.  Determinism: deterministic.  Errors: none.
stateUpdate(KernelState state, BarContext context) =>
    state.barCount := state.barCount + 1
    state.lastProcessedBarIndex := context.barIndex

// stateGet(state)   @internal
//   Responsibility : Return the kernel state handle (the single mutable global).
//   Parameters     : state — KernelState.
//   Returns        : KernelState.
//   Determinism    : pure accessor.  Errors: none.
//   Note           : identity in the current reference-passing wiring; kept as the
//                    canonical accessor seam for later modules.
stateGet(KernelState state) =>
    state

// stateReset(state)   @internal  (debug only)
//   Responsibility : Clear diagnostics and reset counters (does NOT rebuild config).
//   Parameters     : state — KernelState.
//   Returns        : void.  Determinism: deterministic.  Errors: none.
//   Note           : diagnostic / testing aid; not part of the normal lifecycle.
stateReset(KernelState state) =>
    logClear(state.diag)
    state.barCount := 0
    state.lastProcessedBarIndex := 0
    state.errorLatched := false

// -----------------------------------------------------------------------------
//  Core · lifecycle — coreInit / coreOnBar (M1.4).
//  coreInit runs once (first bar); coreOnBar runs every bar and returns the
//  BarContext seam that modules 02-14 will consume.
// -----------------------------------------------------------------------------

// coreInit()   @stable
//   Responsibility : Build config + kernel state once, and (in debug) run the
//                    diagnostics harness exercising util / log / err / cfg / ctx.
//   Returns        : KernelState.
//   Determinism    : deterministic per run.
//   Errors         : fatal — invalid config or an unsupported timeframe halt here.
coreInit() =>
    Diagnostics diag = Diagnostics.new()
    Config config = cfgBuild(diag)
    KernelState state = stateInit(config, diag)
    if config.debugEnabled
        // util — pure helper edge cases.
        errAssert(utilClamp(2.0, UTIL_NORMALIZED_MIN, UTIL_NORMALIZED_MAX) == UTIL_NORMALIZED_MAX, ERR_ASSERT_FAILED, "utilClamp upper bound", true)
        errAssert(utilClamp(-2.0, UTIL_NORMALIZED_MIN, UTIL_NORMALIZED_MAX) == UTIL_NORMALIZED_MIN, ERR_ASSERT_FAILED, "utilClamp lower bound", true)
        errAssert(utilSafeDiv(1.0, 0.0, UTIL_NORMALIZED_MIN) == UTIL_NORMALIZED_MIN, ERR_ASSERT_FAILED, "utilSafeDiv guards zero", true)
        errAssert(utilNormalize(5.0, 0.0, 10.0) == 0.5, ERR_ASSERT_FAILED, "utilNormalize midpoint", true)
        errAssert(not utilIsValidNumber(na), ERR_ASSERT_FAILED, "utilIsValidNumber rejects na", true)
        // log — ring buffer round-trip (write at the active threshold so it always emits).
        logWrite(state.diag, config.logThreshold, MODULE_ID_CORE, ERR_NONE, "core self-test", config.logThreshold, config.debugEnabled)
        errAssert(array.size(logDrain(state.diag)) >= 1, ERR_ASSERT_FAILED, "logDrain returns entries", true)
        logClear(state.diag)
        errAssert(array.size(logDrain(state.diag)) == 0, ERR_ASSERT_FAILED, "logClear empties buffer", true)
        // cfg / ctx / state — config accessible, context builds, state initialized.
        errAssert(state.initialized, ERR_ASSERT_FAILED, "state initialized", true)
        errAssert(cfgGet(state).diagBufferCap >= DIAG_BUFFER_CAP_MIN, ERR_ASSERT_FAILED, "config accessible via cfgGet", true)
        errAssert(not na(ctxBuild(config)), ERR_ASSERT_FAILED, "context builds", true)
    state

// coreOnBar(state)   @stable
//   Responsibility : Per-bar seam — build the BarContext and advance state.
//   Parameters     : state — KernelState.
//   Returns        : BarContext (consumed by modules 02-14).
//   Determinism    : deterministic per bar; non-repainting.
//   Errors         : none (debug assertions only).
coreOnBar(KernelState state) =>
    Config config = cfgGet(state)
    BarContext context = ctxBuild(config)
    stateUpdate(state, context)
    if config.debugEnabled
        errAssert(state.barCount == context.barIndex + 1, ERR_ASSERT_FAILED, "barCount parity (single init + monotonic)", true)
    context


// =============================================================================
//  MODULE PLACEHOLDERS (02 – 14)
// -----------------------------------------------------------------------------
//  Documentation seams only — no code runs here. Scope and order are
//  authoritative in docs/SPECIFICATION.md and docs/ROADMAP.md.
// -----------------------------------------------------------------------------
//  02 Trend Engine        05 Market Structure     08 Fair Value Gap
//  03 Momentum Engine     06 Liquidity            09 Signal Engine
//  04 Support/Resistance  07 Order Blocks         10 Trade Engine
//  11 Risk Manager        12 Dashboard            13 Alerts
//  14 Optimization
//  TODO: implement per each src/modules/<NN-name>/README.md
// =============================================================================


// =============================================================================
//  MAIN
// -----------------------------------------------------------------------------
//  Single lifecycle wiring. coreInit() runs once (var initializer); coreOnBar()
//  runs every bar and returns the BarContext seam for modules 02-14. No orders,
//  no plots, no calculations — this build still produces zero trading behavior.
//  `context` is intentionally unused for now: it is the integration point that
//  the analysis modules (02+) will consume.
// =============================================================================
var KernelState coreState = coreInit()
BarContext context = coreOnBar(coreState)


