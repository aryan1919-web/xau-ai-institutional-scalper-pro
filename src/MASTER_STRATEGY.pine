// -- Trend Engine (Module 02) configuration inputs (consumed only by cfgBuild).
bool   inpTrendUseMtf            = input.bool(false, "Use HTF confirmation", group = G_02_TREND, tooltip = "Confirm the chart-timeframe trend against a higher timeframe. No effect until M2.4.")
string inpTrendHtf               = input.timeframe("5", "HTF timeframe", group = G_02_TREND, tooltip = "Higher timeframe for confirmation (must be >= chart timeframe). Read via ctxHtfValue in M2.4.")
