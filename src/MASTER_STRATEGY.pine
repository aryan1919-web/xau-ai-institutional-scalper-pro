// =============================================================================
//  XAU AI Institutional Scalper Pro
// -----------------------------------------------------------------------------
//  Project      : xau-ai-institutional-scalper-pro
//  File         : src/MASTER_STRATEGY.pine
//  Purpose      : Primary strategy entry point. The ONLY file TradingView
//                 compiles. All modules are integrated here (module docs live
//                 under src/modules/ as markdown only).
//  Market       : XAUUSD (Gold vs. US Dollar)
//  Timeframes   : M1, M5 (intraday scalping)
//  Version      : 0.0.3  (Module 01 · M1.2 — utility, logging, validation)
//  License      : MIT (see LICENSE)
//  Language     : Pine Script v6 ONLY
//
//  STATUS       : FRAMEWORK ONLY — Module 01 (Core Framework), milestone M1.2.
//                 Implemented subsystems (defined, not yet wired to a call site):
//                   - util : pure helpers (clamp, normalize, safeDiv, roundToTick, ...)
//                   - log  : bounded O(1) diagnostics ring buffer (level/debug gated)
//                   - err  : hybrid validation (fatal halt / recoverable warning)
//                 Still absent (later milestones): cfg (M1.3), ctx (M1.3),
//                 state + lifecycle + integration (M1.4).
//                 Contains NO trading behavior: no entries/exits/orders, no
//                 request.security, no ta.*, no plots, no calculations. The
//                 subsystems are defined but not invoked (MAIN remains no-op).
//
//  REPAINTING   : Forbidden project-wide. When logic is added, all higher-
//                 timeframe access will use request.security(..., lookahead =
//                 barmerge.lookahead_off) on confirmed bars; act on bar close.
//
//  DETERMINISM  : The eventual scoring engine (Module 09) MUST be deterministic
//                 and explainable. No black-box logic.
//
//  See also     : src/modules/01-core-framework/README.md, docs/ARCHITECTURE.md,
//                 docs/STYLE_GUIDE.md, docs/API.md, docs/DECISIONS.md
// =============================================================================


// =============================================================================
//  STRATEGY DECLARATION
// -----------------------------------------------------------------------------
//  Declaration only. Metadata is explicit and conservative. No orders are
//  generated anywhere in this build.
// =============================================================================
strategy(
     title                  = "XAU AI Institutional Scalper Pro",
     shorttitle             = "XAU-AISP",
     overlay                = true,
     pyramiding             = 0,
     initial_capital        = 10000,
     default_qty_type       = strategy.percent_of_equity,
     default_qty_value      = 1,
     currency               = currency.USD,
     commission_type        = strategy.commission.percent,
     commission_value       = 0.0,
     slippage               = 0,
     calc_on_every_tick     = false,
     process_orders_on_close = true,
     close_entries_rule     = "ANY")


// =============================================================================
//  CONSTANTS
// -----------------------------------------------------------------------------
//  Structural constants only (identity, module identifiers, diagnostics sizing).
//  No indicator parameters and no numeric trading thresholds — those arrive with
//  their owning modules. Named constants exist so no "magic numbers" leak later.
// =============================================================================

// -- Project identity ---------------------------------------------------------
const string PROJECT_NAME    = "XAU AI Institutional Scalper Pro"
const string PROJECT_VERSION = "0.0.3"
const string PRIMARY_SYMBOL  = "XAUUSD"

// -- Total number of planned modules (see docs/ROADMAP.md). Documentation /
//    self-description only; no logic depends on this value.
const int MODULE_COUNT = 14

// -- Diagnostics ring-buffer capacity (bounded; within the Performance Budget,
//    docs/SPECIFICATION.md#performance-budget). Consumed by the logging
//    subsystem in M1.2; declared here as the single source of the cap.
const int DIAG_BUFFER_CAP = 100

// -- Module identifiers (used as LogEntry.moduleId; no magic strings). Values
//    match the prefix registry in docs/STYLE_GUIDE.md.
const string MODULE_ID_CORE       = "CORE"
const string MODULE_ID_TREND      = "TREND"
const string MODULE_ID_MOMENTUM   = "MOM"
const string MODULE_ID_SR         = "SR"
const string MODULE_ID_STRUCTURE  = "STRUCT"
const string MODULE_ID_LIQUIDITY  = "LIQ"
const string MODULE_ID_ORDERBLOCK = "OB"
const string MODULE_ID_FVG        = "FVG"
const string MODULE_ID_SIGNAL     = "SIG"
const string MODULE_ID_TRADE      = "TRADE"
const string MODULE_ID_RISK       = "RISK"
const string MODULE_ID_DASHBOARD  = "DASH"
const string MODULE_ID_ALERTS     = "ALERT"
const string MODULE_ID_OPTIMIZE   = "OPT"

// -- Utility constants (definitional; not tunable trading parameters).
const float UTIL_NORMALIZED_MIN = 0.0   // lower bound of a normalized value
const float UTIL_NORMALIZED_MAX = 1.0   // upper bound of a normalized value
const int   MINUTES_PER_HOUR    = 60    // minutes-of-day conversion factor
const int   DECIMAL_BASE        = 10    // base for decimal-precision rounding

// -- Error-ID registry. Stable identifiers used by the validation / error
//    subsystem and stamped into LogEntry.errorId. Format: CORE-<AREA>-<NNN>.
const string ERR_NONE                 = ""               // no associated error
const string ERR_CFG_UNSUPPORTED_TF   = "CORE-CFG-001"   // primary timeframe not supported
const string ERR_CFG_INVALID_SESSION  = "CORE-CFG-002"   // malformed / inverted session window
const string ERR_CFG_DIAG_CAP_RANGE   = "CORE-CFG-003"   // diagnostics buffer cap out of range
const string ERR_STATE_REINIT         = "CORE-STATE-001" // attempted re-initialization
const string ERR_ASSERT_FAILED        = "CORE-ASSERT-001"// debug assertion failed

// -- Input group titles (kept as constants to avoid duplicated string literals).
const string G_01_CORE       = "01 · Core Framework"
const string G_02_TREND      = "02 · Trend Engine"
const string G_03_MOMENTUM   = "03 · Momentum Engine"
const string G_04_SR         = "04 · Support / Resistance Engine"
const string G_05_STRUCTURE  = "05 · Market Structure"
const string G_06_LIQUIDITY  = "06 · Liquidity"
const string G_07_ORDERBLOCK = "07 · Order Blocks"
const string G_08_FVG        = "08 · Fair Value Gap"
const string G_09_SIGNAL     = "09 · Signal Engine"
const string G_10_TRADE      = "10 · Trade Engine"
const string G_11_RISK       = "11 · Risk Manager"
const string G_12_DASHBOARD  = "12 · Dashboard"
const string G_13_ALERTS     = "13 · Alerts"
const string G_14_OPTIMIZE   = "14 · Optimization"


// =============================================================================
//  ENUMS
// -----------------------------------------------------------------------------
//  Shared vocabulary owned by the Core Framework and reused across module
//  boundaries (docs/DECISIONS.md ADR-0007). Module-specific enums (e.g. trend
//  regime, market phase) are owned by their modules and added when built.
// =============================================================================

// Direction — shared directional vocabulary (bias, structure, signal, trade).
enum Direction
    long
    short
    flat

// SessionState — whether the current bar is inside an active trading session.
enum SessionState
    inactive
    active

// TimeframeClass — classification of the chart timeframe for validation.
enum TimeframeClass
    m1
    m5
    other

// LogLevel — ordered diagnostic severity (error highest, debug lowest).
enum LogLevel
    error
    warn
    info
    debug

// ValidationSeverity — classifies a validation result for the hybrid policy.
enum ValidationSeverity
    ok
    warning
    fatal


// =============================================================================
//  TYPES (USER-DEFINED TYPES)
// -----------------------------------------------------------------------------
//  Shared data structures owned by the Core Framework. Declared in dependency
//  order (a type is defined before any type that references it). Fields carry
//  neutral defaults; object-typed and array fields default to na and are
//  populated by their owning subsystem in later milestones. "Immutable" types
//  (e.g. Config) are enforced by convention — only the owning subsystem writes.
// =============================================================================

// LogEntry — one diagnostics record (stored in the ring buffer). Owned by `log`.
type LogEntry
    LogLevel level     = LogLevel.info
    int      barIndex  = 0
    int      time      = 0
    string   moduleId  = ""
    string   errorId   = ""
    string   message   = ""

// Diagnostics — bounded ring buffer of LogEntry plus counters. Owned by `log`;
// lives inside KernelState (persistent). `entries` is allocated in M1.2.
type Diagnostics
    array<LogEntry> entries
    int             head         = 0
    int             count        = 0
    int             capacity     = 0
    int             droppedCount = 0

// TimeframeContext — chart-timeframe classification (constant per run). Owned by `ctx`.
type TimeframeContext
    TimeframeClass tfClass            = TimeframeClass.other
    bool           isSupportedPrimary = false

// SessionContext — session sub-context for a bar. Owned by `ctx`.
type SessionContext
    SessionState state    = SessionState.inactive
    bool         isActive = false

// BarContext — per-bar computed context (transient). Owned by `ctx`.
type BarContext
    int              barIndex    = 0
    int              time        = 0
    bool             isConfirmed = false
    bool             isNewBar    = false
    SessionContext   session
    TimeframeContext tf

// ValidationResult — one configuration validation finding (transient). Owned by validation.
type ValidationResult
    ValidationSeverity severity = ValidationSeverity.ok
    string             errorId  = ""
    string             message  = ""

// Config — immutable, validated configuration snapshot. Owned by `cfg`; built
// once and read via cfgGet(). Trading parameters are added by their modules.
type Config
    bool           debugEnabled       = false
    LogLevel       logThreshold       = LogLevel.info
    TimeframeClass primaryTfClass     = TimeframeClass.other
    bool           requireSupportedTf = true
    bool           sessionEnabled     = false
    string         sessionSpec        = ""
    int            diagBufferCap      = DIAG_BUFFER_CAP
    // Module enable toggles (mirror of the inputs; consumed by cfgBuild in M1.3).
    bool           enableCore         = false
    bool           enableTrend        = false
    bool           enableMomentum     = false
    bool           enableSr           = false
    bool           enableStructure    = false
    bool           enableLiquidity    = false
    bool           enableOrderBlock   = false
    bool           enableFvg          = false
    bool           enableSignal       = false
    bool           enableTrade        = false
    bool           enableRisk         = false
    bool           enableDashboard    = false
    bool           enableAlerts       = false
    bool           enableOptimize     = false

// KernelState — the single persistent (var) object; the sole mutable global
// (docs/DECISIONS.md ADR-0009). Owned by `state`; created on the first bar.
type KernelState
    Config           config
    bool             initialized           = false
    int              barCount              = 0
    int              lastProcessedBarIndex = 0
    TimeframeContext tf
    Diagnostics      diag
    bool             errorLatched          = false


