bool inpEnableCore       = input.bool(false, "Enable Module (placeholder)", group = G_01_CORE,       tooltip = "Core framework services. Placeholder — no effect in v0.1.0.")
bool inpEnableTrend      = input.bool(false, "Enable Trend Engine", group = G_02_TREND, tooltip = "Master enable for the Trend Engine (Module 02). Configuration only in v0.1.2; trend logic arrives in M2.3+.")
bool inpEnableMomentum   = input.bool(false, "Enable Module (placeholder)", group = G_03_MOMENTUM,   tooltip = "Momentum engine. Placeholder — no effect in v0.1.0.")
