// =============================================================================
//  CORE SUBSYSTEM SCAFFOLDING
// -----------------------------------------------------------------------------
//  Empty, bannered sections for the Core Framework subsystems, in dependency
//  order. No functions exist yet — each subsystem is implemented in a later
//  milestone. These banners fix the canonical section ordering (STYLE_GUIDE §8).
// =============================================================================

// -----------------------------------------------------------------------------
//  Core · util — pure, deterministic helpers (M1.2).
//  Side-effect free. No indicators, no trading logic.
// -----------------------------------------------------------------------------

// utilIsValidNumber(value)   @stable
//   Responsibility : Report whether a value is usable (not na).
//   Parameters     : value — float.
//   Returns        : bool — true when value is not na.
//   Determinism    : pure; no state.
//   Errors         : none. Note: Pine surfaces non-finite results as na.
utilIsValidNumber(float value) =>
    not na(value)

// utilClamp(value, lo, hi)   @stable
//   Responsibility : Constrain value to the inclusive range [lo, hi].
//   Returns        : float — the clamped value.
//   Determinism    : pure.  Errors: none.
utilClamp(float value, float lo, float hi) =>
    math.max(lo, math.min(hi, value))

// utilSafeDiv(num, den, fallback)   @stable
//   Responsibility : Divide, guarding against zero / na operands.
//   Returns        : float — num / den, or fallback when unsafe.
//   Determinism    : pure.  Errors: none (returns fallback instead of na/inf).
utilSafeDiv(float num, float den, float fallback) =>
    na(den) or na(num) or den == 0 ? fallback : num / den

// utilNormalize(value, lo, hi)   @stable
//   Responsibility : Scale value from [lo, hi] into [0, 1], clamped.
//   Returns        : float in [0, 1]; the lower bound when lo == hi (safe).
//   Determinism    : pure.  Errors: none.
utilNormalize(float value, float lo, float hi) =>
    float ratio = utilSafeDiv(value - lo, hi - lo, UTIL_NORMALIZED_MIN)
    utilClamp(ratio, UTIL_NORMALIZED_MIN, UTIL_NORMALIZED_MAX)

// utilRoundToTick(price)   @stable
//   Responsibility : Round a price to the instrument tick (syminfo.mintick).
//   Returns        : float — tick-aligned price; input passed through when invalid.
//   Determinism    : pure w.r.t. price and symbol.  Errors: none.
utilRoundToTick(float price) =>
    utilIsValidNumber(price) ? math.round(price / syminfo.mintick) * syminfo.mintick : price

// utilMinutesOfDay(t)   @internal
//   Responsibility : Minutes elapsed since midnight (exchange tz) for time t.
//   Returns        : int — hour * 60 + minute.
//   Determinism    : pure given t.  Errors: none.
utilMinutesOfDay(int t) =>
    hour(t) * MINUTES_PER_HOUR + minute(t)

// utilFormatFloat(value, precision)   @internal
//   Responsibility : Format a float to a fixed number of decimals for diagnostics.
//   Returns        : string — "na" when value is na.
//   Determinism    : pure.  Errors: none.
utilFormatFloat(float value, int precision) =>
    if na(value)
        "na"
    else
        float factor = math.pow(DECIMAL_BASE, precision)
        str.tostring(math.round(value * factor) / factor)

// -----------------------------------------------------------------------------
//  Core · log — bounded diagnostics ring buffer (M1.2).
//  O(1) insertion. Gated by level + debug. Operates on a caller-owned
//  Diagnostics handle (KernelState wiring arrives in M1.4).
// -----------------------------------------------------------------------------

// logLevelRank(level)   @internal
//   Responsibility : Ordinal severity rank (0 = highest). Single source of the
//                    ordering so logShouldEmit does not duplicate the mapping
//                    (satisfies the no-duplication rule).
//   Returns        : int rank in [0, 3].
//   Determinism    : pure.  Errors: none.
logLevelRank(LogLevel level) =>
    switch level
        LogLevel.error => 0
        LogLevel.warn  => 1
        LogLevel.info  => 2
        LogLevel.debug => 3
        => 3

// logShouldEmit(level, threshold, debugEnabled)   @internal
//   Responsibility : Decide whether a message at `level` is emitted, given the
//                    active threshold and debug flag.
//   Returns        : bool.
//   Determinism    : pure.  Errors: none.
logShouldEmit(LogLevel level, LogLevel threshold, bool debugEnabled) =>
    bool passesThreshold = logLevelRank(level) <= logLevelRank(threshold)
    bool requiresDebug   = level == LogLevel.debug or level == LogLevel.info
    passesThreshold and (not requiresDebug or debugEnabled)

// logFormat(entry)   @internal
//   Responsibility : Render a LogEntry as one diagnostic line.
//   Returns        : string "[LEVEL MODULE ERRID b#N] message".
//   Determinism    : pure.  Errors: none.
logFormat(LogEntry entry) =>
    string levelLabel = switch entry.level
        LogLevel.error => "ERROR"
        LogLevel.warn  => "WARN"
        LogLevel.info  => "INFO"
        LogLevel.debug => "DEBUG"
        => "INFO"
    string idPart = entry.errorId == ERR_NONE ? "" : " " + entry.errorId
    "[" + levelLabel + " " + entry.moduleId + idPart + " b#" + str.tostring(entry.barIndex) + "] " + entry.message

// logWrite(diag, level, moduleId, errorId, message, threshold, debugEnabled)   @stable
//   Responsibility : Append one gated entry to the ring buffer (O(1)).
//   Returns        : void.
//   Determinism    : deterministic per bar (stamps bar_index / time).
//   Errors         : none. Note: the oldest entry is overwritten when full.
logWrite(Diagnostics diag, LogLevel level, string moduleId, string errorId, string message, LogLevel threshold, bool debugEnabled) =>
    if logShouldEmit(level, threshold, debugEnabled)
        if na(diag.entries)
            diag.entries      := array.new<LogEntry>(DIAG_BUFFER_CAP)
            diag.capacity     := DIAG_BUFFER_CAP
            diag.head         := 0
            diag.count        := 0
            diag.droppedCount := 0
        LogEntry entry = LogEntry.new(level, bar_index, time, moduleId, errorId, message)
        array.set(diag.entries, diag.head, entry)
        diag.head := (diag.head + 1) % diag.capacity
        if diag.count < diag.capacity
            diag.count := diag.count + 1
        else
            diag.droppedCount := diag.droppedCount + 1

// logDrain(diag)   @experimental
//   Responsibility : Snapshot buffered entries, oldest -> newest.
//   Returns        : array<LogEntry> — a new array; empty when nothing buffered.
//   Determinism    : deterministic. Complexity O(count), count <= DIAG_BUFFER_CAP;
//                    on-demand, not a per-bar hot path.
//   Errors         : none.
logDrain(Diagnostics diag) =>
    array<LogEntry> out = array.new<LogEntry>(0)
    if not na(diag.entries) and diag.count > 0
        int start = (diag.head - diag.count + diag.capacity) % diag.capacity
        for i = 0 to diag.count - 1
            array.push(out, array.get(diag.entries, (start + i) % diag.capacity))
    out

// logClear(diag)   @experimental
//   Responsibility : Logically empty the buffer (O(1); counters reset).
//   Returns        : void.  Determinism: deterministic.  Errors: none.
logClear(Diagnostics diag) =>
    diag.head         := 0
    diag.count        := 0
    diag.droppedCount := 0

// -----------------------------------------------------------------------------
//  Core · err — error handling and hybrid validation (M1.2).
//  Fatal -> halt (runtime.error); recoverable -> logged warning.
// -----------------------------------------------------------------------------

// errFormat(severity, errorId, message)   @internal
//   Responsibility : Render an error / validation line.
//   Returns        : string "[SEVERITY] ERRID: message".
//   Determinism    : pure.  Errors: none.
errFormat(ValidationSeverity severity, string errorId, string message) =>
    string sev = switch severity
        ValidationSeverity.fatal   => "FATAL"
        ValidationSeverity.warning => "WARNING"
        ValidationSeverity.ok      => "OK"
        => "OK"
    string idPart = errorId == ERR_NONE ? "" : errorId + ": "
    "[" + sev + "] " + idPart + message

// errRaiseFatal(errorId, message)   @stable
//   Responsibility : Abort the script with a descriptive fatal error.
//   Returns        : never (runtime.error halts execution).
//   Determinism    : deterministic.  Errors: raises runtime.error by design.
errRaiseFatal(string errorId, string message) =>
    runtime.error(errFormat(ValidationSeverity.fatal, errorId, message))

// errWarn(diag, errorId, message, threshold, debugEnabled)   @stable
//   Responsibility : Record a non-fatal warning to diagnostics.
//   Returns        : void.  Determinism: deterministic.  Errors: none.
errWarn(Diagnostics diag, string errorId, string message, LogLevel threshold, bool debugEnabled) =>
    logWrite(diag, LogLevel.warn, MODULE_ID_CORE, errorId, message, threshold, debugEnabled)

// errAssert(condition, errorId, message, debugEnabled)   @stable
//   Responsibility : Debug-only invariant check; halts if it fails while debug is on.
//   Returns        : void.  Determinism: deterministic.
//   Errors         : raises runtime.error when debugEnabled and condition is false.
errAssert(bool condition, string errorId, string message, bool debugEnabled) =>
    if debugEnabled and not condition
        errRaiseFatal(errorId, "assertion failed: " + message)

// errApplyValidation(diag, results, threshold, debugEnabled)   @experimental
//   Responsibility : Apply the hybrid policy over validation results —
//                    the first fatal halts; each warning is logged.
//   Returns        : void.  Determinism: deterministic. Complexity O(size(results)).
//   Errors         : raises runtime.error on the first fatal result.
errApplyValidation(Diagnostics diag, array<ValidationResult> results, LogLevel threshold, bool debugEnabled) =>
    if not na(results)
        int n = array.size(results)
        for i = 0 to n - 1
            ValidationResult r = array.get(results, i)
            if r.severity == ValidationSeverity.fatal
                errRaiseFatal(r.errorId, r.message)
            else if r.severity == ValidationSeverity.warning
                errWarn(diag, r.errorId, r.message, threshold, debugEnabled)

